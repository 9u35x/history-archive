<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="14dp" android:layout_marginBottom="8dp" android:background="#1A1A24">
    <TextView android:id="@+id/tvReportTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
    <TextView android:id="@+id/tvReportSub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#888888" android:textSize="12sp" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/tvReportStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#9B5CFF" android:textSize="12sp" android:layout_marginTop="6dp" />
</LinearLayout>
