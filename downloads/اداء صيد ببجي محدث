        "mahmoud", "ali", "mohamed", "ahmed", "mustafa", "omar", "youssef", "khaled", 
        "ibrahim", "hassan", "kareem", "tarek", "fady", "sayed", "hany", "amr", "alaa"
    ]
    last_names = ["ed", "alali", "hassan", "salem", "saad", "mansour", "fahmy", "ramadan"]
    
    f_name = random.choice(first_names)
    l_name = random.choice(last_names)
    year_full = str(random.randint(1998, 2007))
    num_sub = str(random.randint(10, 99))
    
    email_styles = [
        f"{f_name}{l_name}{num_sub}",
        f"{f_name}.{l_name}{year_full}",
        f"{l_name}.{f_name}{num_sub}"
    ]
    
    domains = ["gmail.com", "yahoo.com", "outlook.com"]
    email = f"{random.choice(email_styles)}@{random.choice(domains)}"
    
    pass_f_name = random.choice(first_names).capitalize()
    password = f"{pass_f_name}{random.choice(last_names)}{year_full}"
    
    level = random.randint(55, 85)
    
    if level >= 75:
        tier = "👑 MYTHIC / NADIR"
    elif level >= 65:
        tier = "✨ VIP / ACTIVE"
    else:
        tier = "⚙️ STANDARD"
        
    return email, password, level, method, tier

